<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Active Care - Fix Admin Login</title>
<style>
  body{font-family:'Segoe UI',Arial,sans-serif;text-align:center;padding:40px;background:#0B6B5A;color:#fff;margin:0}
  .box{background:#fff;color:#0F2A2E;max-width:480px;margin:0 auto;padding:28px;border-radius:16px;box-shadow:0 20px 40px rgba(0,0,0,.25)}
  .box h2{margin:0 0 8px;color:#0B6B5A}
  .box p{color:#6B7C7A;font-size:14px;line-height:1.5}
  button{padding:14px 28px;border:none;border-radius:10px;background:#0B6B5A;color:#fff;font-weight:700;font-size:16px;cursor:pointer}
  button:hover{opacity:.92}
  #msg{margin-top:14px;font-weight:600;color:#0B6B5A;min-height:20px}
  small{color:#94A3A8}
</style>
</head>
<body>
<div class="box">
  <h2>Active Care - Fix Admin Login</h2>
  <p>Click the button below once. It will reset the Admin account to ALL branches and clear the old password, without deleting sales, stock or medicines.</p>
  <button onclick="fixAdmin()">Fix Admin & Open System</button>
  <p id="msg"></p>
  <small>Default login after fix:<br><b>Username:</b> admin &nbsp; | &nbsp; <b>Password:</b> ActiveCare</small>
</div>

<script>
function fixAdmin(){
  try{
    // Load existing users from localStorage
    let users = JSON.parse(localStorage.getItem('ac_users') || '[]');

    if(!users.length){
      // No users found - create default Admin
      users = [{id:1, fullName:'Active Care - Admin', username:'admin', passHash:'', role:'Admin', branch:'ALL', shift:'All', phone:''}];
    } else {
      // Fix existing Admin: force branch to ALL, role to Admin, clear old password hash
      users = users.map(u => u.username.toLowerCase() === 'admin'
        ? {...u, branch:'ALL', role:'Admin', shift:'All', passHash:''}
        : u);
    }

    localStorage.setItem('ac_users', JSON.stringify(users));
    document.getElementById('msg').innerText = 'Done! Admin fixed to ALL branches. Opening system...';

    // Redirect to main system after 1 second
    setTimeout(() => { window.location.href = './index.html'; }, 1000);

  } catch(e){
    document.getElementById('msg').innerText = 'Error: ' + e.message;
  }
}
</script>
</body>
</html>